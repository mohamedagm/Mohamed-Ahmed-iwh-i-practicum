doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    header
      h1= title
      a(href="/") Return to the homepage

    main
      form(action="/update-cobj", method="POST")
        div
          label(for="name") Name
          input#name(type="text", name="name", required=true)

        div
          label(for="type") Type
          input#type(type="text", name="type", required=true)

        div
          label(for="bio") Bio
          textarea#bio(name="bio", rows="4")

        div
          button(type="submit") Submit
