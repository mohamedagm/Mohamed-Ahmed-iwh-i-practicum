doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    .container
      header.header
        h1.header__title= title
        a.button(href="/") Return to the homepage

      main.content
        form.form(action="/update-cobj", method="POST")
          .form__row
            label.form__label(for="name") Name
            input.form__input#name(type="text", name="name", required=true, placeholder="e.g. Fluffy")

          .form__row
            label.form__label(for="type") Type
            input.form__input#type(type="text", name="type", required=true, placeholder="e.g. Cat")

          .form__row
            label.form__label(for="bio") Bio
            textarea.form__textarea#bio(name="bio", rows="5", placeholder="Short description...")

          .form__actions
            button.button(type="submit") Save
            a.button.button--ghost(href="/") Cancel
