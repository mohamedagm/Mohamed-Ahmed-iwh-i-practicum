doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    .container
      header.header
        h1.header__title= title
        a.button(href="/update-cobj") Add/Update this table

      main.content
        if data && data.length
          .table-wrap
            table.table
              thead.table__head
                tr
                  th ID
                  th Name
                  th Type
                  th Bio
              tbody.table__body
                each item in data
                  tr.table__row
                    td.table__cell= item.id
                    td.table__cell= (item.properties && item.properties.name) || ''
                    td.table__cell= (item.properties && item.properties.type) || ''
                    td.table__cell= (item.properties && item.properties.bio) || ''
        else
          .empty
            p No records found.
            a.button.button--ghost(href="/update-cobj") Add your first record
